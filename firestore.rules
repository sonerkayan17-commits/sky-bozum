rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == "sonerkayan17@gmail.com"
      );
    }

    function validAuthor() {
      return request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 40;
    }

    function validComment() {
      return request.resource.data.keys().hasOnly([
          "parentId", "author", "uid", "service", "message", "rating", "status", "createdAt"
        ])
        && (
          request.resource.data.status == "pending"
          || (signedIn() && request.resource.data.status == "approved")
        )
        && request.resource.data.createdAt == request.time
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
        && validAuthor()
        && request.resource.data["service"] is string
        && request.resource.data["service"].size() >= 2
        && request.resource.data["service"].size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 600;
    }

    // Public forum yalnızca aktif Sky Bozum mimarisindeki 30 alt kategori için
    // okunabilir. Eski konular silinmez; yöneticiler bunları arşivden okumaya
    // devam eder.
    function isPublicForumKey(value) {
      return value == "mobil-odeme-operatorler/mobil-odeme-genel"
        || value == "mobil-odeme-operatorler/turkcell"
        || value == "mobil-odeme-operatorler/vodafone"
        || value == "mobil-odeme-operatorler/turk-telekom"
        || value == "mobil-odeme-operatorler/mobil-odeme-limit-sorunlari"
        || value == "dijital-kod-hediye-kartlari/razer-gold-tl"
        || value == "dijital-kod-hediye-kartlari/razer-gold-usd"
        || value == "dijital-kod-hediye-kartlari/apple-itunes"
        || value == "dijital-kod-hediye-kartlari/steam"
        || value == "dijital-kod-hediye-kartlari/kod-sorunlari"
        || value == "dijital-cuzdanlar/paycell"
        || value == "dijital-cuzdanlar/pokus"
        || value == "dijital-cuzdanlar/vodafone-pay"
        || value == "dijital-cuzdanlar/dijital-cuzdan-limitleri"
        || value == "dijital-cuzdanlar/dijital-cuzdan-sorunlari"
        || value == "bozum-oranlar/guncel-oranlar"
        || value == "bozum-oranlar/oran-hesaplama"
        || value == "bozum-oranlar/komisyonlar"
        || value == "bozum-oranlar/odeme-suresi"
        || value == "bozum-oranlar/yuksek-oran-uyarilari"
        || value == "guvenlik-dolandiricilik/guvenli-islem"
        || value == "guvenlik-dolandiricilik/paylasilmamasi-gereken-bilgiler"
        || value == "guvenlik-dolandiricilik/sahte-siteler"
        || value == "guvenlik-dolandiricilik/whatsapp-guvenligi"
        || value == "guvenlik-dolandiricilik/supheli-islem-bildirimleri"
        || value == "sky-bozum-destek-topluluk/duyurular"
        || value == "sky-bozum-destek-topluluk/nasil-islem-yapilir"
        || value == "sky-bozum-destek-topluluk/sik-sorulanlar"
        || value == "sky-bozum-destek-topluluk/oneri-geri-bildirim"
        || value == "sky-bozum-destek-topluluk/genel-sohbet";
    }

    function validPublicForumPost(data) {
      return data.status == "published"
        && data.visibility == "public"
        && data.forumKey is string
        && isPublicForumKey(data.forumKey);
    }

    match /comments/{commentId} {
      allow read: if resource.data.status == "approved" || isAdmin();
      allow create: if validComment();
      allow update, delete: if isAdmin();
    }

    match /referenceEngagements/{engagementId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          "type", "targetId", "visitorId", "createdAt"
        ])
        && (request.resource.data.type == "like" || request.resource.data.type == "view")
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 100
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 8
        && request.resource.data.visitorId.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /members/{memberId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == memberId);
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly([
          "displayName", "phone", "email", "role", "status", "balance", "points", "permissions", "createdAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "member"
        && request.resource.data.status == "pending"
        && request.resource.data.balance == 0
        && request.resource.data.points == 0
        && request.resource.data.permissions.size() == 0
        && request.resource.data.createdAt == request.time
      );
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == memberId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "phone"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
      );
      allow delete: if false;
    }

    match /memberActivities/{activityId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["uid", "type", "targetId", "title", "href", "points", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() <= 140
        && request.resource.data.href is string && request.resource.data.href.size() <= 180
        && ((request.resource.data.type == "like" && request.resource.data.points == 1)
          || (request.resource.data.type == "comment" && request.resource.data.points == 2)
          || (request.resource.data.type == "share" && request.resource.data.points == 3));
      allow update, delete: if false;
    }

    match /memberPrivate/{memberId} {
      allow read: if signedIn() && request.auth.uid == memberId;
      allow create, update: if signedIn() && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(["accountHolder", "bankName", "iban", "updatedAt"])
        && request.resource.data.accountHolder is string
        && request.resource.data.accountHolder.size() >= 2
        && request.resource.data.accountHolder.size() <= 80
        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() <= 80
        && request.resource.data.iban is string
        && request.resource.data.iban.size() >= 24
        && request.resource.data.iban.size() <= 34
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /memberSubscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /memberPosts/{postId} {
      allow read: if isAdmin() || validPublicForumPost(resource.data);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && validPublicForumPost(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 30000
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.author == resource.data.author
        && validPublicForumPost(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 30000
        && request.resource.data.updatedAt == request.time);
      allow delete: if isAdmin();
    }

    match /publicProfiles/{memberId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(["displayName", "avatar", "createdAt"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 30000;
      allow delete: if false;
    }

    match /profileLikes/{likeId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /pointGifts/{giftId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.amount == 5 && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 600 && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.receiverId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.receiverId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if false;
    }

    match /commentLikes/{likeId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /memberLedger/{entryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.memberId is string
        && (request.resource.data.kind == "balance" || request.resource.data.kind == "points")
        && request.resource.data.amount is number
        && request.resource.data.balanceAfter is number
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /contentArticles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contentAudit/{entryId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
