rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == "sonerkayan17@gmail.com"
      );
    }

    function staffRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role
        : "member";
    }

    function canModerate() {
      return isAdmin() || staffRole() == "moderator";
    }

    function canManageContent() {
      return isAdmin() || staffRole() == "editor" || staffRole() == "publisher";
    }

    function canOperate() {
      return isAdmin() || staffRole() == "operator" || staffRole() == "moderator";
    }

    function notBanned() {
      return !signedIn()
        || !exists(/databases/$(database)/documents/members/$(request.auth.uid))
        || get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status != "banned";
    }

    function validAuthor() {
      return request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 40;
    }

    function validComment() {
      return request.resource.data.keys().hasOnly([
          "parentId", "author", "uid", "service", "message", "rating", "status", "createdAt"
        ])
        && (
          request.resource.data.status == "pending"
          || (signedIn() && request.resource.data.status == "approved")
        )
        && request.resource.data.createdAt == request.time
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
        && validAuthor()
        && notBanned()
        && request.resource.data["service"] is string
        && request.resource.data["service"].size() >= 2
        && request.resource.data["service"].size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 600;
    }

    // Public forum yalnızca aktif Sky Bozum mimarisindeki 30 alt kategori için
    // okunabilir. Eski konular silinmez; yöneticiler bunları arşivden okumaya
    // devam eder.
    function isPublicForumKey(value) {
      return value == "mobil-odeme-operatorler/mobil-odeme-genel"
        || value == "mobil-odeme-operatorler/turkcell"
        || value == "mobil-odeme-operatorler/vodafone"
        || value == "mobil-odeme-operatorler/turk-telekom"
        || value == "mobil-odeme-operatorler/mobil-odeme-limit-sorunlari"
        || value == "dijital-kod-hediye-kartlari/razer-gold-tl"
        || value == "dijital-kod-hediye-kartlari/razer-gold-usd"
        || value == "dijital-kod-hediye-kartlari/apple-itunes"
        || value == "dijital-kod-hediye-kartlari/steam"
        || value == "dijital-kod-hediye-kartlari/kod-sorunlari"
        || value == "dijital-cuzdanlar/paycell"
        || value == "dijital-cuzdanlar/pokus"
        || value == "dijital-cuzdanlar/vodafone-pay"
        || value == "dijital-cuzdanlar/dijital-cuzdan-limitleri"
        || value == "dijital-cuzdanlar/dijital-cuzdan-sorunlari"
        || value == "bozum-oranlar/guncel-oranlar"
        || value == "bozum-oranlar/oran-hesaplama"
        || value == "bozum-oranlar/komisyonlar"
        || value == "bozum-oranlar/odeme-suresi"
        || value == "bozum-oranlar/yuksek-oran-uyarilari"
        || value == "guvenlik-dolandiricilik/guvenli-islem"
        || value == "guvenlik-dolandiricilik/paylasilmamasi-gereken-bilgiler"
        || value == "guvenlik-dolandiricilik/sahte-siteler"
        || value == "guvenlik-dolandiricilik/whatsapp-guvenligi"
        || value == "guvenlik-dolandiricilik/supheli-islem-bildirimleri"
        || value == "sky-bozum-destek-topluluk/duyurular"
        || value == "sky-bozum-destek-topluluk/nasil-islem-yapilir"
        || value == "sky-bozum-destek-topluluk/sik-sorulanlar"
        || value == "sky-bozum-destek-topluluk/oneri-geri-bildirim"
        || value == "sky-bozum-destek-topluluk/genel-sohbet";
    }

    function validPublicForumPost(data) {
      return data.status == "published"
        && data.visibility == "public"
        && data.forumKey is string
        && isPublicForumKey(data.forumKey);
    }

    function validForumDraft(data) {
      return (data.status == "pending" || data.status == "published")
        && data.visibility == "public"
        && data.forumKey is string
        && isPublicForumKey(data.forumKey);
    }

    match /comments/{commentId} {
      allow read: if resource.data.status == "approved" || isAdmin();
      allow create: if validComment();
      allow update, delete: if canModerate();
    }

    match /referenceEngagements/{engagementId} {
      allow read: if signedIn() && resource.data.profileId == request.auth.uid;
      allow create: if notBanned() && request.resource.data.keys().hasOnly([
          "type", "targetId", "visitorId", "memberId", "memberName", "createdAt"
        ])
        && (request.resource.data.type == "like" || request.resource.data.type == "view")
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 100
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 8
        && request.resource.data.visitorId.size() <= 80
        && (request.resource.data.type == "view"
          || !request.resource.data.keys().hasAny(["memberId", "memberName"])
          || (signedIn()
            && request.resource.data.memberId == request.auth.uid
            && request.resource.data.memberName is string
            && request.resource.data.memberName.size() >= 2
            && request.resource.data.memberName.size() <= 80))
        && request.resource.data.createdAt == request.time;
      allow update: if request.resource.data.visitorId == resource.data.visitorId
        && request.resource.data.type == resource.data.type
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberId", "memberName", "createdAt"])
        && (resource.data.type == "view"
          || (signedIn() && resource.data.memberId == request.auth.uid && request.resource.data.memberId == request.auth.uid));
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == memberId);
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly([
          "displayName", "avatar", "phone", "email", "role", "status", "balance", "points", "permissions", "referralCode", "referredBy", "createdAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "member"
        && request.resource.data.status == "pending"
        && request.resource.data.balance == 0
        && request.resource.data.points == 0
        && request.resource.data.permissions.size() == 0
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 30000
        && request.resource.data.referralCode is string
        && request.resource.data.referralCode.size() >= 8
        && request.resource.data.referralCode.size() <= 20
        && (request.resource.data.referredBy == null || request.resource.data.referredBy is string)
        && request.resource.data.createdAt == request.time
      );
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == memberId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "phone", "avatar"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 30000
      );
      allow delete: if false;
    }

    match /memberActivities/{activityId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(["uid", "type", "targetId", "title", "href", "points", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() <= 140
        && request.resource.data.href is string && request.resource.data.href.size() <= 180
        && ((request.resource.data.type == "like" && request.resource.data.points == 1)
          || (request.resource.data.type == "comment" && request.resource.data.points == 2)
          || (request.resource.data.type == "share" && request.resource.data.points == 3));
      allow update, delete: if false;
    }

    match /memberPrivate/{memberId} {
      allow read: if signedIn() && request.auth.uid == memberId;
      allow create, update: if signedIn() && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(["accountHolder", "bankName", "iban", "updatedAt"])
        && request.resource.data.accountHolder is string
        && request.resource.data.accountHolder.size() >= 2
        && request.resource.data.accountHolder.size() <= 80
        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() <= 80
        && request.resource.data.iban is string
        && request.resource.data.iban.size() >= 24
        && request.resource.data.iban.size() <= 34
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /memberSubscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "href", "createdAt"])
        && request.resource.data.title is string
        && request.resource.data.href is string;
      allow delete: if false;
    }

    match /memberBookmarks/{bookmarkId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(["uid", "targetId", "title", "href", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 120
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 140
        && request.resource.data.href is string
        && request.resource.data.href.size() <= 180
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "href"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.targetId == resource.data.targetId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /memberPosts/{postId} {
      allow read: if canModerate() || validPublicForumPost(resource.data)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && notBanned()
        && request.resource.data.uid == request.auth.uid
        && validForumDraft(request.resource.data)
        && request.resource.data.status == "pending"
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 30000
        && request.resource.data.createdAt == request.time;
      allow update: if canModerate() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.author == resource.data.author
        && resource.data.locked != true
        && validForumDraft(request.resource.data)
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == "published" && request.resource.data.status == "pending"))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 30000
        && request.resource.data.updatedAt == request.time);
      allow delete: if canModerate();
    }

    match /publicProfiles/{memberId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(["displayName", "avatar", "referralCode", "createdAt"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 30000;
      allow delete: if false;
    }

    match /referralRelations/{relationId} {
      allow read: if signedIn() && (resource.data.referrerId == request.auth.uid || resource.data.refereeId == request.auth.uid);
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(["referrerId", "refereeId", "refereeName", "referralCode", "createdAt"])
        && request.resource.data.refereeId == request.auth.uid
        && request.resource.data.referrerId != request.auth.uid
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.referredBy == request.resource.data.referrerId
        && request.resource.data.refereeName is string
        && request.resource.data.refereeName.size() >= 2
        && request.resource.data.refereeName.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /referralRewards/{rewardId} {
      allow read: if signedIn() && (resource.data.referrerId == request.auth.uid || resource.data.refereeId == request.auth.uid);
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(["referrerId", "refereeId", "sourceTargetId", "sourcePoints", "rewardPoints", "createdAt"])
        && request.resource.data.refereeId == request.auth.uid
        && request.resource.data.referrerId == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.referredBy
        && (request.resource.data.sourcePoints == 1 || request.resource.data.sourcePoints == 2 || request.resource.data.sourcePoints == 3)
        && request.resource.data.rewardPoints == request.resource.data.sourcePoints / 10
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /profileVisits/{visitId} {
      allow read: if signedIn() && resource.data.profileId == request.auth.uid;
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(["profileId", "visitorId", "visitorName", "visitorAvatar", "viewedAt"])
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.profileId != request.auth.uid
        && request.resource.data.visitorName is string
        && request.resource.data.visitorName.size() >= 2
        && request.resource.data.visitorName.size() <= 80
        && request.resource.data.visitorAvatar is string
        && request.resource.data.visitorAvatar.size() <= 30000
        && request.resource.data.viewedAt == request.time;
      allow update: if signedIn()
        && resource.data.visitorId == request.auth.uid
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.visitorId == resource.data.visitorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visitorName", "visitorAvatar", "viewedAt"])
        && request.resource.data.viewedAt == request.time;
      allow delete: if false;
    }

    match /profileLikes/{likeId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /pointGifts/{giftId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && notBanned() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.amount == 5 && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && notBanned() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 600 && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.receiverId == request.auth.uid;
      allow create: if signedIn() && notBanned()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.type is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 180
        && request.resource.data.href is string
        && request.resource.data.href.size() <= 180
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.receiverId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if false;
    }

    match /contentReports/{reportId} {
      allow read: if canModerate();
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(["targetType", "targetId", "reporterId", "reason", "status", "createdAt"])
        && (request.resource.data.targetType == "forum_post" || request.resource.data.targetType == "comment")
        && request.resource.data.targetId is string
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 240
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "resolvedBy", "resolvedAt"])
        && request.resource.data.status == "resolved"
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time;
      allow delete: if false;
    }

    match /forumPostRevisions/{revisionId} {
      allow read: if canModerate();
      allow create: if canModerate()
        && request.resource.data.keys().hasOnly(["postId", "title", "body", "status", "visibility", "editedBy", "createdAt"])
        && request.resource.data.postId is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.editedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /commentLikes/{likeId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /memberLedger/{entryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.memberId is string
        && (request.resource.data.kind == "balance" || request.resource.data.kind == "points")
        && request.resource.data.amount is number
        && request.resource.data.balanceAfter is number
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && settingId == "global"
        && request.resource.data.keys().hasOnly([
          "brandName", "brandTagline", "footerDescription", "phone", "email",
          "whatsapp", "liveSupportLabel", "supportHours", "defaultSeoTitle",
          "defaultSeoDescription", "heroEyebrow", "heroTitle", "heroLead", "heroPrimaryCta",
          "proofExperience", "proofTransactions", "announcementEnabled", "announcementText", "announcementHref", "updatedBy", "updatedAt"
        ])
        && request.resource.data.brandName is string && request.resource.data.brandName.size() >= 2 && request.resource.data.brandName.size() <= 80
        && request.resource.data.brandTagline is string && request.resource.data.brandTagline.size() <= 180
        && request.resource.data.footerDescription is string && request.resource.data.footerDescription.size() <= 300
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 220
        && request.resource.data.liveSupportLabel is string && request.resource.data.liveSupportLabel.size() <= 80
        && request.resource.data.supportHours is string && request.resource.data.supportHours.size() <= 80
        && request.resource.data.defaultSeoTitle is string && request.resource.data.defaultSeoTitle.size() <= 180
        && request.resource.data.defaultSeoDescription is string && request.resource.data.defaultSeoDescription.size() <= 300
        && request.resource.data.heroEyebrow is string && request.resource.data.heroEyebrow.size() <= 140
        && request.resource.data.heroTitle is string && request.resource.data.heroTitle.size() >= 5 && request.resource.data.heroTitle.size() <= 180
        && request.resource.data.heroLead is string && request.resource.data.heroLead.size() <= 320
        && request.resource.data.heroPrimaryCta is string && request.resource.data.heroPrimaryCta.size() <= 80
        && request.resource.data.proofExperience is string && request.resource.data.proofExperience.size() <= 40
        && request.resource.data.proofTransactions is string && request.resource.data.proofTransactions.size() <= 40
        && request.resource.data.announcementEnabled is bool
        && request.resource.data.announcementText is string && request.resource.data.announcementText.size() <= 180
        && request.resource.data.announcementHref is string && request.resource.data.announcementHref.size() <= 220
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /contentArticles/{articleId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update: if canManageContent();
      allow delete: if isAdmin();
    }

    match /contentAudit/{entryId} {
      allow read, create: if isAdmin() || canManageContent() || canModerate();
      allow update, delete: if false;
    }

    match /rateOverrides/{rateId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /operations/{operationId} {
      allow read: if canOperate() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if signedIn() && notBanned()
        && ((canOperate() && request.resource.data.createdBy == request.auth.uid)
          || (request.resource.data.memberId == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == "new"
            && request.resource.data.payout == 0))
        && request.resource.data["customer"] is string
        && request.resource.data["customer"].size() >= 2
        && request.resource.data["customer"].size() <= 100
        && request.resource.data["contact"] is string
        && request.resource.data["contact"].size() >= 3
        && request.resource.data["contact"].size() <= 120
        && request.resource.data["service"] is string
        && request.resource.data["service"].size() >= 2
        && request.resource.data["amount"] is number
        && request.resource.data["amount"] > 0;
      allow update: if canOperate()
        && request.resource.data["customer"] is string
        && request.resource.data["customer"].size() >= 2
        && request.resource.data["customer"].size() <= 100
        && request.resource.data["contact"] is string
        && request.resource.data["contact"].size() >= 3
        && request.resource.data["contact"].size() <= 120
        && request.resource.data["service"] is string
        && request.resource.data["service"].size() >= 2
        && request.resource.data["amount"] is number
        && request.resource.data["amount"] > 0
        && request.resource.data["payout"] is number
        && request.resource.data["payout"] >= 0
        && request.resource.data["status"] in ["new", "awaiting_product", "checking", "awaiting_payment", "completed", "cancelled"];
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
