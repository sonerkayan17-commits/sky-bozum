rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == "sonerkayan17@gmail.com"
      );
    }

    function staffRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role
        : "member";
    }

    function canModerate() {
      return isAdmin() || (approvedMember() && notBanned() && staffRole() == "moderator");
    }

    function canManageContent() {
      return isAdmin() || (
        approvedMember()
        && notBanned()
        && (staffRole() == "editor" || staffRole() == "publisher")
      );
    }

    function canOperate() {
      return isAdmin() || (
        approvedMember()
        && notBanned()
        && (staffRole() == "operator" || staffRole() == "moderator")
      );
    }

    function notBanned() {
      return !signedIn()
        || !exists(/databases/$(database)/documents/members/$(request.auth.uid))
        || get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status != "banned"
        || (
          get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("bannedUntil", null) is timestamp
          && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.bannedUntil <= request.time
        );
    }

    function capabilityAllowed(capability) {
      return !signedIn()
        || !exists(/databases/$(database)/documents/members/$(request.auth.uid))
        || !get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("restrictions", []).hasAny([capability]);
    }

    function approvedMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == "active"
          || (
            get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == "banned"
            && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get("bannedUntil", null) is timestamp
            && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.bannedUntil <= request.time
          )
        );
    }

    function verifiedMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && approvedMember()
        && notBanned();
    }

    // Yonetici hesabi, e-posta dogrulama kaydi eski bir oturumda henuz
    // yenilenmemis olsa bile kendi icerigini yonetebilmelidir. Bu istisna
    // yalniz mevcut isAdmin() kontrolunden gecen hesaplar icindir; normal
    // uyeler icin e-posta dogrulama zorunlulugu aynen devam eder.
    function verifiedMemberOrAdmin() {
      return verifiedMember() || isAdmin();
    }

    function freshCreateTimestamp(value) {
      return value == request.time
        && value > request.time - duration.value(2, "m")
        && value < request.time + duration.value(1, "m");
    }

    // Kullaniciya ait deterministik belge anahtarlarinda ilk get istegi,
    // belge henuz yokken de izinli olmalidir. Aksi halde istemci "var mi?"
    // kontrolunu yapamaz ve yeni kaydi olusturmadan once hata alir.
    function ownsScopedDocument(documentId) {
      return signedIn() && documentId.matches("^" + request.auth.uid + "_.*");
    }

    function validAuthor() {
      return request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 40;
    }

    function validComment() {
      return request.resource.data.keys().hasOnly([
          "parentId", "author", "uid", "service", "message", "rating", "status", "createdAt"
        ])
        && (
          request.resource.data.status == "pending"
          || (verifiedMemberOrAdmin() && request.resource.data.status == "approved")
        )
        && freshCreateTimestamp(request.resource.data.createdAt)
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
        && validAuthor()
        && notBanned()
        && (!signedIn() || isAdmin() || approvedMember())
        && capabilityAllowed("community")
        && request.resource.data["service"] is string
        && request.resource.data["service"].size() >= 2
        && request.resource.data["service"].size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 600;
    }

    // Public forum yalnızca aktif Sky Bozum mimarisindeki 30 alt kategori için
    // okunabilir. Eski konular silinmez; yöneticiler bunları arşivden okumaya
    // devam eder.
    function isPublicForumKey(value) {
      return value == "mobil-odeme-operatorler/mobil-odeme-genel"
        || value == "mobil-odeme-operatorler/turkcell"
        || value == "mobil-odeme-operatorler/vodafone"
        || value == "mobil-odeme-operatorler/turk-telekom"
        || value == "mobil-odeme-operatorler/mobil-odeme-limit-sorunlari"
        || value == "dijital-kod-hediye-kartlari/razer-gold-tl"
        || value == "dijital-kod-hediye-kartlari/razer-gold-usd"
        || value == "dijital-kod-hediye-kartlari/apple-itunes"
        || value == "dijital-kod-hediye-kartlari/steam"
        || value == "dijital-kod-hediye-kartlari/kod-sorunlari"
        || value == "dijital-cuzdanlar/paycell"
        || value == "dijital-cuzdanlar/pokus"
        || value == "dijital-cuzdanlar/vodafone-pay"
        || value == "dijital-cuzdanlar/dijital-cuzdan-limitleri"
        || value == "dijital-cuzdanlar/dijital-cuzdan-sorunlari"
        || value == "bozum-oranlar/guncel-oranlar"
        || value == "bozum-oranlar/oran-hesaplama"
        || value == "bozum-oranlar/komisyonlar"
        || value == "bozum-oranlar/odeme-suresi"
        || value == "bozum-oranlar/yuksek-oran-uyarilari"
        || value == "guvenlik-dolandiricilik/guvenli-islem"
        || value == "guvenlik-dolandiricilik/paylasilmamasi-gereken-bilgiler"
        || value == "guvenlik-dolandiricilik/sahte-siteler"
        || value == "guvenlik-dolandiricilik/whatsapp-guvenligi"
        || value == "guvenlik-dolandiricilik/supheli-islem-bildirimleri"
        || value == "sky-bozum-destek-topluluk/duyurular"
        || value == "sky-bozum-destek-topluluk/nasil-islem-yapilir"
        || value == "sky-bozum-destek-topluluk/sik-sorulanlar"
        || value == "sky-bozum-destek-topluluk/oneri-geri-bildirim"
        || value == "sky-bozum-destek-topluluk/genel-sohbet";
    }

    function validPublicForumPost(data) {
      return data.status == "published"
        && data.visibility == "public"
        && data.forumKey is string
        && isPublicForumKey(data.forumKey);
    }

    function validForumDraft(data) {
      return (data.status == "pending" || data.status == "published")
        && data.visibility == "public"
        && data.forumKey is string
        && isPublicForumKey(data.forumKey);
    }

    function validSiteSettingsKeys(data) {
      return data.keys().hasOnly([
        "brandName", "brandTagline", "footerDescription", "phone", "email",
        "whatsapp", "liveSupportLabel", "supportHours", "defaultSeoTitle",
        "defaultSeoDescription", "heroEyebrow", "heroTitle", "heroLead", "heroPrimaryCta",
        "proofExperience", "proofTransactions", "announcementEnabled", "announcementText", "announcementHref",
        "searchPlaceholder", "searchQuickAccessTitle", "searchContinueTitle", "searchFeaturedTitle", "searchRecentEnabled",
        "searchQuickActionRateEnabled", "searchQuickActionRateTitle", "searchQuickActionRateDescription", "searchQuickActionRateHref",
        "searchQuickActionServicesEnabled", "searchQuickActionServicesTitle", "searchQuickActionServicesDescription", "searchQuickActionServicesHref",
        "searchQuickActionTrustEnabled", "searchQuickActionTrustTitle", "searchQuickActionTrustDescription", "searchQuickActionTrustHref",
        "searchQuickActionSupportEnabled", "searchQuickActionSupportTitle", "searchQuickActionSupportDescription", "searchQuickActionSupportHref",
        "savedItemsLabel", "updatedBy", "updatedAt"
      ]);
    }

    function validSiteSettingsCore(data) {
      return data.brandName is string && data.brandName.size() >= 2 && data.brandName.size() <= 80
        && data.brandTagline is string && data.brandTagline.size() <= 180
        && data.footerDescription is string && data.footerDescription.size() <= 300
        && data.phone is string && data.phone.size() <= 30
        && data.email is string && data.email.size() <= 120
        && data.whatsapp is string && data.whatsapp.matches("^https://wa[.]me/[0-9]{8,15}([?].*)?$") && data.whatsapp.size() <= 220
        && data.liveSupportLabel is string && data.liveSupportLabel.size() <= 80
        && data.supportHours is string && data.supportHours.size() <= 80
        && data.defaultSeoTitle is string && data.defaultSeoTitle.size() <= 180
        && data.defaultSeoDescription is string && data.defaultSeoDescription.size() <= 300
        && data.heroEyebrow is string && data.heroEyebrow.size() <= 140
        && data.heroTitle is string && data.heroTitle.size() >= 5 && data.heroTitle.size() <= 180
        && data.heroLead is string && data.heroLead.size() <= 320
        && data.heroPrimaryCta is string && data.heroPrimaryCta.size() <= 80
        && data.proofExperience is string && data.proofExperience.size() <= 40
        && data.proofTransactions is string && data.proofTransactions.size() <= 40
        && data.announcementEnabled is bool
        && data.announcementText is string && data.announcementText.size() <= 180
        && data.announcementHref is string && data.announcementHref.size() <= 220;
    }

    function validSearchAction(data, enabledKey, titleKey, descriptionKey, hrefKey) {
      return data[enabledKey] is bool
        && data[titleKey] is string && data[titleKey].size() >= 2 && data[titleKey].size() <= 80
        && data[descriptionKey] is string && data[descriptionKey].size() >= 4 && data[descriptionKey].size() <= 180
        && data[hrefKey] is string && data[hrefKey].matches("^(/|https://).*$") && data[hrefKey].size() >= 1 && data[hrefKey].size() <= 220;
    }

    function validSiteSearchSettings(data) {
      return data.searchPlaceholder is string && data.searchPlaceholder.size() >= 3 && data.searchPlaceholder.size() <= 120
        && data.searchQuickAccessTitle is string && data.searchQuickAccessTitle.size() >= 2 && data.searchQuickAccessTitle.size() <= 80
        && data.searchContinueTitle is string && data.searchContinueTitle.size() >= 2 && data.searchContinueTitle.size() <= 80
        && data.searchFeaturedTitle is string && data.searchFeaturedTitle.size() >= 2 && data.searchFeaturedTitle.size() <= 80
        && data.searchRecentEnabled is bool
        && data.savedItemsLabel is string && data.savedItemsLabel.size() >= 2 && data.savedItemsLabel.size() <= 80
        && validSearchAction(data, "searchQuickActionRateEnabled", "searchQuickActionRateTitle", "searchQuickActionRateDescription", "searchQuickActionRateHref")
        && validSearchAction(data, "searchQuickActionServicesEnabled", "searchQuickActionServicesTitle", "searchQuickActionServicesDescription", "searchQuickActionServicesHref")
        && validSearchAction(data, "searchQuickActionTrustEnabled", "searchQuickActionTrustTitle", "searchQuickActionTrustDescription", "searchQuickActionTrustHref")
        && validSearchAction(data, "searchQuickActionSupportEnabled", "searchQuickActionSupportTitle", "searchQuickActionSupportDescription", "searchQuickActionSupportHref");
    }

    function validSiteSettings(data) {
      return validSiteSettingsKeys(data)
        && validSiteSettingsCore(data)
        && validSiteSearchSettings(data);
    }

    match /comments/{commentId} {
      allow read: if resource.data.status == "approved" || isAdmin();
      allow create: if validComment();
      allow update, delete: if canModerate();
    }

    match /referenceEngagements/{engagementId} {
      // Yalnız içerik sayaçları tutulur; kullanıcı adı/e-posta tutulmaz.
      // Bu yüzden herkese açık sayaçların gerçek zamanlı okunması güvenlidir.
      allow read: if true;
      allow create: if notBanned() && request.resource.data.keys().hasOnly([
          "type", "targetId", "visitorId", "createdAt"
        ])
        && (request.resource.data.type == "like" || request.resource.data.type == "view")
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 100
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 8
        && request.resource.data.visitorId.size() <= 80
        && freshCreateTimestamp(request.resource.data.createdAt);
      allow update: if request.resource.data.visitorId == resource.data.visitorId
        && request.resource.data.type == resource.data.type
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.keys().hasOnly(["type", "targetId", "visitorId", "createdAt"])
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == memberId);
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly([
          "displayName", "avatar", "phone", "email", "role", "status", "balance", "points", "permissions", "referralCode", "referredBy", "createdAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "member"
        && request.resource.data.status == "pending"
        && request.resource.data.balance == 0
        && request.resource.data.points == 0
        && request.resource.data.permissions.size() == 0
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 30000
        && request.resource.data.referralCode is string
        && request.resource.data.referralCode.size() >= 8
        && request.resource.data.referralCode.size() <= 20
        && (request.resource.data.referredBy == null || request.resource.data.referredBy is string)
        && freshCreateTimestamp(request.resource.data.createdAt)
      );
      allow update: if isAdmin() || (
        verifiedMember() && request.auth.uid == memberId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "phone", "avatar"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 30000
      ) || (
        verifiedMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["points", "lastPointGiftId", "updatedAt"])
        && request.resource.data.lastPointGiftId is string
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/pointGifts/$(request.resource.data.lastPointGiftId)).data.senderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/pointGifts/$(request.resource.data.lastPointGiftId)).data.amount == 5
        && (
          (memberId == request.auth.uid
            && getAfter(/databases/$(database)/documents/pointGifts/$(request.resource.data.lastPointGiftId)).data.receiverId != memberId
            && request.resource.data.points == resource.data.points - 5)
          || (memberId != request.auth.uid
            && getAfter(/databases/$(database)/documents/pointGifts/$(request.resource.data.lastPointGiftId)).data.receiverId == memberId
            && request.resource.data.points == resource.data.points + 5)
        )
      ) || (
        verifiedMember()
        && memberId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["balance", "lastStoreOrderId", "updatedAt"])
        && request.resource.data.lastStoreOrderId is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.lastStoreOrderId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.lastStoreOrderId)).data.priceMinor is int
        && request.resource.data.balance == resource.data.balance - (getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.lastStoreOrderId)).data.priceMinor / 100)
      );
      allow delete: if false;
    }

    match /memberActivities/{activityId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if verifiedMemberOrAdmin()
        && request.resource.data.keys().hasOnly(["uid", "type", "targetId", "title", "href", "points", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() <= 140
        && request.resource.data.href is string && request.resource.data.href.size() <= 180
        && ((request.resource.data.type == "like" && request.resource.data.points == 1)
          || (request.resource.data.type == "comment" && request.resource.data.points == 2)
          || (request.resource.data.type == "share" && request.resource.data.points == 3));
      allow update, delete: if false;
    }

    match /memberPrivate/{memberId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == memberId);
      allow create, update: if verifiedMember() && capabilityAllowed("wallet") && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(["accountHolder", "bankName", "iban", "updatedAt"])
        && request.resource.data.accountHolder is string
        && request.resource.data.accountHolder.size() >= 2
        && request.resource.data.accountHolder.size() <= 80
        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() <= 80
        && request.resource.data.iban is string
        && request.resource.data.iban.matches('^TR[0-9]{24}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /memberSubscriptions/{subscriptionId} {
      allow get: if ownsScopedDocument(subscriptionId);
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if verifiedMemberOrAdmin()
        && subscriptionId == request.auth.uid + "_" + request.resource.data.targetId
        && request.resource.data.keys().hasOnly(["uid", "targetId", "title", "href", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.href is string
        && request.resource.data.href.size() >= 1
        && request.resource.data.href.size() <= 180
        && freshCreateTimestamp(request.resource.data.createdAt);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "href", "createdAt"])
        && request.resource.data.title is string
        && request.resource.data.href is string;
      allow delete: if false;
    }

    match /memberBookmarks/{bookmarkId} {
      allow get: if ownsScopedDocument(bookmarkId);
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if verifiedMemberOrAdmin()
        && request.resource.data.keys().hasOnly(["uid", "targetId", "title", "href", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 120
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 140
        && request.resource.data.href is string
        && request.resource.data.href.size() <= 180
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "href"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.targetId == resource.data.targetId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /memberPosts/{postId} {
      allow read: if canModerate() || validPublicForumPost(resource.data)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if verifiedMemberOrAdmin() && (isAdmin() || capabilityAllowed("community"))
        && request.resource.data.uid == request.auth.uid
        && validForumDraft(request.resource.data)
        && (isAdmin() || request.resource.data.status == "pending")
        && request.resource.data.resolutionStatus == "open"
        && request.resource.data.resolvedBy == ""
        && request.resource.data.resolvedAt == null
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 30000
        && request.resource.data.createdAt == request.time;
      allow update: if canModerate() || (verifiedMember() && capabilityAllowed("community")
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.author == resource.data.author
        && resource.data.locked != true
        && request.resource.data.locked == resource.data.locked
        && ((resource.data.resolutionStatus == null
            && request.resource.data.resolutionStatus == "open"
            && request.resource.data.resolvedBy == ""
            && request.resource.data.resolvedAt == null)
          || (request.resource.data.resolutionStatus == resource.data.resolutionStatus
            && request.resource.data.resolvedBy == resource.data.resolvedBy
            && request.resource.data.resolvedAt == resource.data.resolvedAt))
        && validForumDraft(request.resource.data)
        && (request.resource.data.status == resource.data.status
          || (resource.data.status == "published" && request.resource.data.status == "pending"))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 30000
        && request.resource.data.updatedAt == request.time)
        || (verifiedMemberOrAdmin()
          && (isAdmin() || resource.data.uid == request.auth.uid)
          && (resource.data.resolutionStatus == null || resource.data.resolutionStatus != "resolved")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "resolutionStatus", "resolvedBy", "resolvedAt", "updatedAt"
          ])
          && request.resource.data.resolutionStatus == "resolved"
          && request.resource.data.resolvedBy == request.auth.uid
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.updatedAt == request.time);
      allow delete: if canModerate();
    }

    match /publicProfiles/{memberId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(["displayName", "avatar", "referralCode", "createdAt"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 30000;
      allow update: if verifiedMember() && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(["displayName", "avatar", "referralCode", "createdAt"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 30000;
      allow delete: if false;
    }

    match /referralRelations/{relationId} {
      allow read: if signedIn() && (resource.data.referrerId == request.auth.uid || resource.data.refereeId == request.auth.uid);
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(["referrerId", "refereeId", "refereeName", "referralCode", "createdAt"])
        && request.resource.data.refereeId == request.auth.uid
        && request.resource.data.referrerId != request.auth.uid
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.referredBy == request.resource.data.referrerId
        && request.resource.data.refereeName is string
        && request.resource.data.refereeName.size() >= 2
        && request.resource.data.refereeName.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /referralRewards/{rewardId} {
      allow read: if signedIn() && (resource.data.referrerId == request.auth.uid || resource.data.refereeId == request.auth.uid);
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(["referrerId", "refereeId", "sourceTargetId", "sourcePoints", "rewardPoints", "createdAt"])
        && request.resource.data.refereeId == request.auth.uid
        && request.resource.data.referrerId == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.referredBy
        && (request.resource.data.sourcePoints == 1 || request.resource.data.sourcePoints == 2 || request.resource.data.sourcePoints == 3)
        && request.resource.data.rewardPoints == request.resource.data.sourcePoints / 10
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /profileVisits/{visitId} {
      allow read: if signedIn() && resource.data.profileId == request.auth.uid;
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(["profileId", "visitorId", "visitorName", "visitorAvatar", "viewedAt"])
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.profileId != request.auth.uid
        && request.resource.data.visitorName is string
        && request.resource.data.visitorName.size() >= 2
        && request.resource.data.visitorName.size() <= 80
        && request.resource.data.visitorAvatar is string
        && request.resource.data.visitorAvatar.size() <= 30000
        && request.resource.data.viewedAt == request.time;
      allow update: if signedIn()
        && resource.data.visitorId == request.auth.uid
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.visitorId == resource.data.visitorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visitorName", "visitorAvatar", "viewedAt"])
        && request.resource.data.viewedAt == request.time;
      allow delete: if false;
    }

    match /stockAlerts/{alertId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(["userId", "catalogKey", "productSlug", "packId", "productName", "packLabel", "createdAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.catalogKey is string
        && request.resource.data.catalogKey.size() >= 3
        && request.resource.data.catalogKey.size() <= 180
        && request.resource.data.productSlug is string
        && request.resource.data.productSlug.size() >= 2
        && request.resource.data.productSlug.size() <= 80
        && request.resource.data.packId is string
        && request.resource.data.packId.size() >= 1
        && request.resource.data.packId.size() <= 80
        && request.resource.data.productName is string
        && request.resource.data.productName.size() >= 1
        && request.resource.data.productName.size() <= 140
        && request.resource.data.packLabel is string
        && request.resource.data.packLabel.size() >= 1
        && request.resource.data.packLabel.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /profileLikes/{likeId} {
      allow read: if true;
      allow create: if verifiedMember() && capabilityAllowed("community") && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /pointGifts/{giftId} {
      allow get: if ownsScopedDocument(giftId) || (signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid));
      allow list: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if verifiedMember() && capabilityAllowed("community")
        && giftId == request.auth.uid + "_" + request.resource.data.receiverId
        && request.resource.data.keys().hasOnly(["senderId", "receiverId", "amount", "createdAt"])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.amount == 5
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.lastPointGiftId == giftId
        && getAfter(/databases/$(database)/documents/members/$(request.resource.data.receiverId)).data.lastPointGiftId == giftId;
      allow update, delete: if false;
    }

    // Katalog fiyatı ve stok sayısı herkese açıktır. Düz metin kod hiçbir zaman
    // Firestore'a yazılmaz; şifreli stok yalnız doğrulanmış üyeye, teslimat
    // işleminin atomik parçası olarak okunur.
    match /productCatalog/{catalogId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        verifiedMember() && capabilityAllowed("store_purchase")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stockCount", "lastOrderId", "updatedAt"])
        && request.resource.data.lastOrderId is string
        && request.resource.data.updatedAt == request.time
        && resource.data.active == true
        && resource.data.stockCount > 0
        && request.resource.data.stockCount == resource.data.stockCount - 1
        && getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.lastOrderId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.lastOrderId)).data.catalogKey == catalogId
      );

      match /codes/{codeId} {
        allow read: if isAdmin() || (verifiedMember() && capabilityAllowed("store_purchase"));
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          verifiedMember() && capabilityAllowed("store_purchase")
          && resource.data.status == "available"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "deliveredTo", "deliveredAt", "orderId"])
          && request.resource.data.status == "delivered"
          && request.resource.data.deliveredTo == request.auth.uid
          && request.resource.data.deliveredAt == request.time
          && request.resource.data.orderId is string
          && getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.orderId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.orderId)).data.catalogKey == catalogId
          && getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.orderId)).data.codeId == codeId
        );
      }
    }

    match /productOrders/{orderId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if verifiedMember() && capabilityAllowed("store_purchase") && capabilityAllowed("wallet")
        && request.resource.data.keys().hasOnly(["userId", "userEmail", "productSlug", "productName", "packId", "packLabel", "catalogKey", "codeId", "codeEncrypted", "priceMinor", "status", "createdAt", "deliveredAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.status == "delivered"
        && request.resource.data.createdAt == request.time
        && request.resource.data.deliveredAt == request.time
        && request.resource.data.priceMinor is int
        && request.resource.data.priceMinor > 0
        && request.resource.data.priceMinor == get(/databases/$(database)/documents/productCatalog/$(request.resource.data.catalogKey)).data.priceMinor
        && request.resource.data.productSlug == get(/databases/$(database)/documents/productCatalog/$(request.resource.data.catalogKey)).data.productSlug
        && request.resource.data.packId == get(/databases/$(database)/documents/productCatalog/$(request.resource.data.catalogKey)).data.packId
        && request.resource.data.codeEncrypted == get(/databases/$(database)/documents/productCatalog/$(request.resource.data.catalogKey)/codes/$(request.resource.data.codeId)).data.codeEncrypted
        && getAfter(/databases/$(database)/documents/productCatalog/$(request.resource.data.catalogKey)).data.lastOrderId == orderId
        && getAfter(/databases/$(database)/documents/productCatalog/$(request.resource.data.catalogKey)/codes/$(request.resource.data.codeId)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.lastStoreOrderId == orderId;
      allow update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if verifiedMember() && capabilityAllowed("messaging") && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 600 && freshCreateTimestamp(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.receiverId == request.auth.uid;
      allow create: if (isAdmin() || verifiedMember())
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.type is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 180
        && request.resource.data.href is string
        && request.resource.data.href.size() <= 180
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.receiverId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if false;
    }

    match /contentReports/{reportId} {
      allow get: if canModerate() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow list: if canModerate();
      allow create: if verifiedMember()
        && reportId == request.auth.uid + "_" + request.resource.data.targetType + "_" + request.resource.data.targetId
        && request.resource.data.keys().hasOnly(["targetType", "targetId", "reporterId", "reason", "status", "createdAt"])
        && (request.resource.data.targetType == "forum_post" || request.resource.data.targetType == "comment")
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 100
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 240
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "resolvedBy", "resolvedAt"])
        && request.resource.data.status == "resolved"
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time;
      allow delete: if false;
    }

    match /forumPostRevisions/{revisionId} {
      allow read: if canModerate();
      allow create: if canModerate()
        && request.resource.data.keys().hasOnly(["postId", "title", "body", "status", "visibility", "editedBy", "createdAt"])
        && request.resource.data.postId is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.editedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /commentLikes/{likeId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /memberLedger/{entryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if (isAdmin()
        && request.resource.data.memberId is string
        && (request.resource.data.kind == "balance" || request.resource.data.kind == "points")
        && request.resource.data.amount is number
        && request.resource.data.balanceAfter is number
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.createdAt == request.time)
        || (verifiedMember() && capabilityAllowed("community")
          && request.resource.data.giftId is string
          && (entryId == "gift-" + request.resource.data.giftId + "-sender" || entryId == "gift-" + request.resource.data.giftId + "-receiver")
          && request.resource.data.keys().hasOnly(["memberId", "kind", "amount", "balanceAfter", "note", "performedBy", "giftId", "createdAt"])
          && request.resource.data.kind == "points"
          && request.resource.data.amount is int
          && request.resource.data.note is string
          && request.resource.data.note.size() >= 1
          && request.resource.data.note.size() <= 240
          && request.resource.data.performedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/pointGifts/$(request.resource.data.giftId)).data.senderId == request.auth.uid
          && ((request.resource.data.memberId == request.auth.uid
              && request.resource.data.amount == -5
              && request.resource.data.balanceAfter == getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.points)
            || (request.resource.data.memberId == getAfter(/databases/$(database)/documents/pointGifts/$(request.resource.data.giftId)).data.receiverId && request.resource.data.amount == 5)))
        || (verifiedMember() && capabilityAllowed("store_purchase") && capabilityAllowed("wallet")
          && request.resource.data.orderId is string
          && entryId == "store-" + request.resource.data.orderId
          && request.resource.data.keys().hasOnly(["memberId", "kind", "amount", "balanceAfter", "note", "orderId", "performedBy", "createdAt"])
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.kind == "balance"
          && request.resource.data.amount is number
          && request.resource.data.balanceAfter is number
          && request.resource.data.note is string
          && request.resource.data.note.size() >= 1
          && request.resource.data.note.size() <= 240
          && request.resource.data.performedBy == "store"
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.orderId)).data.userId == request.auth.uid
          && request.resource.data.amount == -(getAfter(/databases/$(database)/documents/productOrders/$(request.resource.data.orderId)).data.priceMinor / 100)
          && request.resource.data.balanceAfter == getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.balance);
      allow update, delete: if false;
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && settingId == "global"
        && validSiteSettings(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Site üzerindeki yönetici düzenleme alanları public sayfa içeriğidir.
    // Yazma hakkı Firestore seviyesinde yalnızca admin claim'ine verilir.
    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["type", "value", "alt", "style", "pagePath", "selector", "href", "updatedBy", "updatedAt"])
        && request.resource.data.type in ["text", "image", "dom-text", "dom-image"]
        && request.resource.data.value is string
        && request.resource.data.value.size() >= 1
        && request.resource.data.value.size() <= 1200
        && request.resource.data.alt is string
        && request.resource.data.alt.size() <= 160
        && request.resource.data.pagePath is string
        && request.resource.data.pagePath.size() <= 180
        && request.resource.data.selector is string
        && request.resource.data.selector.size() <= 1200
        && request.resource.data.href is string
        && request.resource.data.href.size() <= 500
        && request.resource.data.style is map
        && request.resource.data.style.keys().hasOnly(["fontFamily", "fontSize", "fontWeight", "textAlign"])
        && request.resource.data.style.fontFamily in ["inherit", "Arial", "Georgia", "Tahoma", "Trebuchet MS", "Verdana"]
        && request.resource.data.style.fontSize in [0, 12, 14, 16, 18, 20, 24, 28, 32, 36, 42, 48, 56, 64]
        && request.resource.data.style.fontWeight in [0, 400, 500, 600, 700, 800, 900]
        && request.resource.data.style.textAlign in ["left", "center", "right"]
        && (request.resource.data.type != "image" && request.resource.data.type != "dom-image" || request.resource.data.value.matches("^(/|https://).*$"))
        && (request.resource.data.type != "dom-text" || (request.resource.data.pagePath.size() > 0 && request.resource.data.selector.size() > 0))
        && (request.resource.data.type != "dom-image" || (request.resource.data.pagePath.size() > 0 && request.resource.data.selector.size() > 0))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /contentArticles/{articleId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update: if canManageContent();
      allow delete: if isAdmin();
    }

    match /contentRevisions/{revisionId} {
      allow read: if canManageContent();
      allow create: if canManageContent()
        && request.resource.data.keys().hasOnly([
          "articleSlug", "slug", "title", "excerpt", "category", "seoTitle",
          "metaDescription", "cover", "body", "keywords", "serviceSlug", "status",
          "source", "createdBy", "createdAt"
        ])
        && request.resource.data.articleSlug is string
        && request.resource.data.articleSlug.size() > 0
        && request.resource.data.articleSlug.size() <= 180
        && request.resource.data.slug == request.resource.data.articleSlug
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.excerpt is string
        && request.resource.data.excerpt.size() <= 420
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.seoTitle is string
        && request.resource.data.seoTitle.size() <= 180
        && request.resource.data.metaDescription is string
        && request.resource.data.metaDescription.size() <= 320
        && request.resource.data.cover is string
        && request.resource.data.cover.size() <= 26000
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 24000
        && request.resource.data.keywords is list
        && request.resource.data.serviceSlug is string
        && request.resource.data.serviceSlug.size() <= 80
        && request.resource.data.status in ["draft", "published", "archived"]
        && request.resource.data.source in ["site", "admin"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /releaseReadiness/{documentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && documentId == "global"
        && request.resource.data.keys().hasOnly(["checks", "notes", "updatedBy", "updatedAt"])
        && request.resource.data.checks is map
        && request.resource.data.checks.keys().hasAll([
          "emailFlowTested", "senderDomainAuthenticated", "firestoreBackupChecked",
          "supportFlowTested", "productionSmokeTested", "mobileNavigationTested",
          "codeMoneyFlowTested", "rateFallbackReviewed", "appCheckEnforced",
          "analyticsAlertsConfigured"
        ])
        && request.resource.data.checks.keys().hasOnly([
          "emailFlowTested", "senderDomainAuthenticated", "firestoreBackupChecked",
          "supportFlowTested", "productionSmokeTested", "mobileNavigationTested",
          "codeMoneyFlowTested", "rateFallbackReviewed", "appCheckEnforced",
          "analyticsAlertsConfigured"
        ])
        && request.resource.data.checks.emailFlowTested is bool
        && request.resource.data.checks.senderDomainAuthenticated is bool
        && request.resource.data.checks.firestoreBackupChecked is bool
        && request.resource.data.checks.supportFlowTested is bool
        && request.resource.data.checks.productionSmokeTested is bool
        && request.resource.data.checks.mobileNavigationTested is bool
        && request.resource.data.checks.codeMoneyFlowTested is bool
        && request.resource.data.checks.rateFallbackReviewed is bool
        && request.resource.data.checks.appCheckEnforced is bool
        && request.resource.data.checks.analyticsAlertsConfigured is bool
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /contentAudit/{entryId} {
      allow read, create: if isAdmin() || canManageContent() || canModerate();
      allow update, delete: if false;
    }

    match /rateOverrides/{rateId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["rate", "maxRate", "status", "updatedBy", "updatedAt"])
        && request.resource.data.rate is number
        && request.resource.data.rate > 0
        && request.resource.data.rate <= 100
        && request.resource.data.maxRate is number
        && request.resource.data.maxRate >= request.resource.data.rate
        && request.resource.data.maxRate <= 100
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /operations/{operationId} {
      allow read: if canOperate() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if verifiedMember()
        && ((canOperate() && request.resource.data.createdBy == request.auth.uid)
          || (request.resource.data.memberId == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == "new"
            && request.resource.data.payout == 0
            && request.resource.data.keys().hasOnly(["memberId", "customer", "contact", "service", "amount", "payout", "status", "note", "createdBy", "updatedBy", "createdAt", "updatedAt"])
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 500
            && freshCreateTimestamp(request.resource.data.createdAt)
            && request.resource.data.updatedAt == request.time)
          || (request.resource.data.memberId == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.updatedBy == request.auth.uid
            && capabilityAllowed("code_sale")
            && capabilityAllowed("wallet")
            && request.resource.data.operationType == "code_sale"
            && request.resource.data.productLabel == "Razer Gold"
            && request.resource.data["service"] in ["razer-gold-tl", "razer-gold-usd"]
            && request.resource.data.status == "new"
            && request.resource.data.payout == 0
            && request.resource.data.payoutState == "pending"
            && request.resource.data.payoutMethod in ["balance", "iban"]
            && request.resource.data.currency in ["TRY", "USD"]
            && request.resource.data.codeValue is int
            && ((request.resource.data.currency == "TRY" && request.resource.data.codeValue in [50, 100, 250, 500, 1000, 1500, 2000, 3000, 3500, 4000, 5000])
              || (request.resource.data.currency == "USD" && request.resource.data.codeValue in [5, 10, 20, 50, 100, 200]))
            && request.resource.data.codeCount is int
            && request.resource.data.codeCount >= 1
            && request.resource.data.codeCount <= 20
            && request.resource.data.amount == request.resource.data.codeValue * request.resource.data.codeCount
            && request.resource.data.codesEncrypted is list
            && request.resource.data.codesEncrypted.size() == request.resource.data.codeCount
            && request.resource.data.codeHashes is list
            && request.resource.data.codeHashes.size() == request.resource.data.codeCount
            && request.resource.data.codeReviews is list
            && request.resource.data.codeReviews.size() == 0
            && request.resource.data.approvedCodeCount == 0
            && request.resource.data.rejectedCodeCount == 0
            && request.resource.data.reviewState == "pending"
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 500
            && request.resource.data.keys().hasOnly(["memberId", "customer", "contact", "service", "amount", "payout", "status", "note", "operationType", "productLabel", "currency", "codeValue", "codeCount", "codesEncrypted", "codeHashes", "codeReviews", "approvedCodeCount", "rejectedCodeCount", "reviewState", "payoutMethod", "payoutState", "createdBy", "updatedBy", "createdAt", "updatedAt"])
            && freshCreateTimestamp(request.resource.data.createdAt)
            && request.resource.data.updatedAt == request.time))
        && request.resource.data["customer"] is string
        && request.resource.data["customer"].size() >= 2
        && request.resource.data["customer"].size() <= 100
        && request.resource.data["contact"] is string
        && request.resource.data["contact"].size() >= 3
        && request.resource.data["contact"].size() <= 120
        && request.resource.data["service"] is string
        && request.resource.data["service"].size() >= 2
        && request.resource.data["amount"] is number
        && request.resource.data["amount"] > 0
        && request.resource.data["amount"] <= 1000000;
      allow update: if canOperate()
        && request.resource.data["customer"] is string
        && request.resource.data["customer"].size() >= 2
        && request.resource.data["customer"].size() <= 100
        && request.resource.data["contact"] is string
        && request.resource.data["contact"].size() >= 3
        && request.resource.data["contact"].size() <= 120
        && request.resource.data["service"] is string
        && request.resource.data["service"].size() >= 2
        && request.resource.data["amount"] is number
        && request.resource.data["amount"] > 0
        && request.resource.data["payout"] is number
        && request.resource.data["payout"] >= 0
        && request.resource.data["payout"] <= 1000000
        && (!(request.resource.data.keys().hasAny(["operationType"])) || request.resource.data.operationType != "code_sale" || request.resource.data.currency == "USD" || request.resource.data.payout <= request.resource.data.amount)
        && request.resource.data["status"] in ["new", "awaiting_product", "checking", "awaiting_payment", "completed", "cancelled"]
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!resource.data.keys().hasAny(["operationType"]) || resource.data.operationType != "code_sale" || (
          request.resource.data.operationType == resource.data.operationType
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.productLabel == resource.data.productLabel
          && request.resource.data["service"] == resource.data["service"]
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.codeValue == resource.data.codeValue
          && request.resource.data.codeCount == resource.data.codeCount
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.codesEncrypted == resource.data.codesEncrypted
          && request.resource.data.codeHashes == resource.data.codeHashes
          && request.resource.data.payoutMethod == resource.data.payoutMethod
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "priority", "note", "payout", "payoutState", "payoutReference", "paidAt", "codeReviews", "approvedCodeCount", "rejectedCodeCount", "reviewState", "updatedBy", "updatedAt"])
          && request.resource.data.codeReviews is list
          && request.resource.data.codeReviews.size() <= request.resource.data.codeCount
          && request.resource.data.approvedCodeCount is int
          && request.resource.data.rejectedCodeCount is int
          && request.resource.data.approvedCodeCount >= 0
          && request.resource.data.rejectedCodeCount >= 0
          && request.resource.data.approvedCodeCount + request.resource.data.rejectedCodeCount == request.resource.data.codeReviews.size()
          && request.resource.data.reviewState in ["pending", "in_progress", "complete"]
          && (!(resource.data.status in ["awaiting_payment", "completed"]) || (
            request.resource.data.codeReviews == resource.data.codeReviews
            && request.resource.data.approvedCodeCount == resource.data.approvedCodeCount
            && request.resource.data.rejectedCodeCount == resource.data.rejectedCodeCount
            && request.resource.data.reviewState == resource.data.reviewState))
          && (resource.data.status != "completed" || (
            request.resource.data.status == "completed"
            && request.resource.data.payout == resource.data.payout
            && request.resource.data.payoutState == resource.data.payoutState
            && request.resource.data.payoutReference == resource.data.payoutReference
            && request.resource.data.paidAt == resource.data.paidAt))
          && (request.resource.data.status != "awaiting_payment" || (
            request.resource.data.reviewState == "complete"
            && request.resource.data.approvedCodeCount > 0
            && request.resource.data.payoutState == "approved"
            && request.resource.data.payout > 0))
          && (request.resource.data.status != "completed" || (
            request.resource.data.payoutState == "paid"
            && request.resource.data.payout > 0
            && request.resource.data.payoutReference is string
            && request.resource.data.payoutReference.size() >= 4
            && request.resource.data.payoutReference.size() <= 120
            && request.resource.data.paidAt == request.time))
        ));
      allow delete: if isAdmin();
    }

    match /codeSaleClaims/{claimId} {
      allow get: if canOperate();
      allow list: if false;
      allow create: if verifiedMember() && capabilityAllowed("code_sale") && capabilityAllowed("wallet")
        && request.resource.data.keys().hasOnly(["operationId", "memberId", "createdAt"])
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.operationId is string
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/operations/$(request.resource.data.operationId)).data.memberId == request.auth.uid
        && getAfter(/databases/$(database)/documents/operations/$(request.resource.data.operationId)).data.operationType == "code_sale"
        && getAfter(/databases/$(database)/documents/operations/$(request.resource.data.operationId)).data.codeHashes.hasAny([claimId]);
      allow update, delete: if false;
    }

    match /operationNotes/{noteId} {
      allow read: if canOperate();
      allow create: if canOperate()
        && request.resource.data.keys().hasOnly(["operationId", "type", "body", "actorId", "createdAt"])
        && request.resource.data.operationId is string
        && request.resource.data.operationId.size() >= 1
        && request.resource.data.operationId.size() <= 180
        && request.resource.data.type in ["note", "status", "system"]
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 600
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Üyeye gösterilen işlem hareketleri ekip içi notlardan ayrı tutulur.
    // Böylece müşteri yalnız kendi işlemine ait, paylaşılması güvenli durum
    // metinlerini gerçek zamanlı okuyabilir; iç operasyon notları sızmaz.
    match /operationEvents/{eventId} {
      allow read: if canOperate()
        || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if canOperate()
        && request.resource.data.keys().hasOnly([
          "operationId", "memberId", "type", "body", "createdAt"
        ])
        && request.resource.data.operationId is string
        && request.resource.data.operationId.size() >= 1
        && request.resource.data.operationId.size() <= 180
        && request.resource.data.memberId is string
        && request.resource.data.memberId.size() >= 1
        && request.resource.data.memberId
          == get(/databases/$(database)/documents/operations/$(request.resource.data.operationId)).data.memberId
        && request.resource.data.type in ["status", "system"]
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
