NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Public site configuration
NEXT_PUBLIC_SITE_URL=https://bozumcu.net.tr
PRIMARY_DOMAIN_CANONICAL_ENABLED=false
# DNS, Vercel domain doğrulaması ve Search Console kontrolleri tamamlanana kadar false kalmalı.
PRIMARY_DOMAIN_REDIRECTS_ENABLED=false
NEXT_PUBLIC_WHATSAPP_URL=
# Optional public App Check key. Leave empty outside the real Firebase project.
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_KEY=
# Optional consent-gated analytics endpoint. Must be HTTPS; no PII is sent.
NEXT_PUBLIC_SKY_TELEMETRY_ENDPOINT=

# 32 random bytes encoded as base64. Used only on the server to encrypt stock codes.
STORE_CODE_ENCRYPTION_KEY=
# Önceki kurulumlarda kullanılan eşdeğer değişken de desteklenir.
CODE_SALE_ENCRYPTION_KEY=

